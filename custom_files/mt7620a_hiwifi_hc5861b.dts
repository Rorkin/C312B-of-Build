/dts-v1/;

#include "mt7620a.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	compatible = "hiwifi,hc5861b", "mediatek,mt7620a-soc";
	model = "HiWiFi HC5861B (R33)";

	aliases {
		led-boot = &led_system;
		led-failsafe = &led_system;
		led-running = &led_system;
		led-upgrade = &led_system;
	};

	leds {
		compatible = "gpio-leds";
		led_system: system {
			label = "blue:system";
			gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;
		};

		internet {
			label = "blue:internet";
			gpios = <&gpio2 15 GPIO_ACTIVE_LOW>;
		};
	};

	keys {
		compatible = "gpio-keys";
		reset {
			label = "reset";
			gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};
};

/* 核心修复：直接在总线下定义 NAND 节点 */
&palmbus {
	nandc@0 {
		compatible = "mediatek,mt7620-nand";
		reg = <0x0 0x100>;
		status = "okay";

		pinctrl-names = "default";
		pinctrl-0 = <&nd_sd_pins>;

		nand-chip@0 {
			reg = <0>;
			label = "mtk-nand";

			partitions {
				compatible = "fixed-partitions";
				#address-cells = <1>;
				#size-cells = <1>;

				partition@0 {
					label = "u-boot";
					reg = <0x0 0x30000>;
					read-only;
				};

				partition@30000 {
					label = "u-boot-env";
					reg = <0x30000 0x10000>;
					read-only;
				};

				factory: partition@40000 {
					label = "factory";
					reg = <0x40000 0x10000>;
					read-only;
				};

				partition@50000 {
					label = "firmware";
					reg = <0x50000 0x7fb0000>;
				};
			};
		};
	};
};

&state_default {
	gpio {
		groups = "i2c", "uartf", "rgmii1", "rgmii2", "wled", "nd_sd";
		function = "gpio";
	};
};

&ethernet {
	pinctrl-names = "default";
	pinctrl-0 = <&rgmii1_pins &rgmii2_pins &mdio_pins>;
	port@5 {
		status = "okay";
		phy-mode = "rgmii";
		mediatek,fixed-link = <1000 1 1 1>;
	};
};

&gsw {
	mediatek,port4 = "gmac";
	mediatek,mdio-mode = <1>;
	status = "okay";
};

&pcie {
	status = "okay";
};
