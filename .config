# .config - OpenWrt 23.05 Minimal Config for HiWiFi R33 (HC5861B)
# Only essential options; make defconfig will expand the rest
#

# Target
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7620=y
CONFIG_TARGET_ramips_mt7620_DEVICE_hiwifi_r33=y

# WiFi
CONFIG_PACKAGE_wpad-basic-wolfssl=y

# LuCI Web Interface
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y

# USB support
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=y

# USB Storage (optional, for 128MB NAND device with USB port)
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y

# Switch
CONFIG_PACKAGE_kmod-switch-rtl8366-smi=y
CONFIG_PACKAGE_kmod-switch-rtl8367b=y
CONFIG_PACKAGE_swconfig=y

# 5GHz WiFi (MT7612EN via PCIe)
CONFIG_PACKAGE_kmod-mt76x2=y

# 2.4GHz WiFi (MT7620A built-in)
CONFIG_PACKAGE_kmod-rt2800-soc=y

# NAND / UBI support
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_kmod-mtd-rw=y

# Netfilter basics
CONFIG_PACKAGE_kmod-ipt-core=y
CONFIG_PACKAGE_kmod-ipt-ipset=y
CONFIG_PACKAGE_kmod-nf-nathelper=y
CONFIG_PACKAGE_kmod-nf-nathelper-extra=y

# Essential tools
CONFIG_PACKAGE_kmod-lib-crc-ccitt=y
CONFIG_PACKAGE_kmod-lib-crc16=y
CONFIG_PACKAGE_kmod-lib-crc32c=y

# ucode (used by 23.05 base system)
CONFIG_PACKAGE_ucode=y
CONFIG_PACKAGE_ucode-mod-fs=y
CONFIG_PACKAGE_ucode-mod-ubus=y
CONFIG_PACKAGE_ucode-mod-uci=y

# Build options
CONFIG_DEVEL=y
CONFIG_CCACHE=y
